<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                            http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.right</groupId>
    <artifactId>guacamole-client-spring-boot</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <description>Apache Guacamole migrated to Spring Boot</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Guacamole 版本 -->
        <revision>1.5.5</revision>
        <guacamole.version>${revision}</guacamole.version>

        <!-- 依赖版本 -->
        <!-- Build identifier: timestamp in yyyyMMddHHmmss format.
             Replaces ${guacamole.build.identifier} in index.html and
             verifyCachedVersion.js during Maven resource filtering.
             Matches original Apache Guacamole build behavior. -->
        <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
        <guacamole.build.identifier>${maven.build.timestamp}</guacamole.build.identifier>

        <guava.version>32.1.3-jre</guava.version>
        <jackson.version>2.17.2</jackson.version>
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
        <zxing.version>3.5.3</zxing.version>
        <apache-ldap.version>2.1.6</apache-ldap.version>
        <commons-lang3.version>3.14.0</commons-lang3.version>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>

        <!-- Third-party dependency versions (centralized management) -->
        <ipaddress.version>5.5.0</ipaddress.version>
        <jakarta-ws-rs.version>3.1.0</jakarta-ws-rs.version>
        <jradius.version>1.1.5</jradius.version>
        <commons-logging.version>1.2</commons-logging.version>
        <commons-collections.version>3.2.2</commons-collections.version>
        <cas-client.version>3.6.4</cas-client.version>
        <jose4j.version>0.9.6</jose4j.version>
        <java-saml.version>2.9.0</java-saml.version>
        <woodstox.version>5.4.0</woodstox.version>
        <xmlsec.version>2.2.6</xmlsec.version>
        <keeper.version>16.6.3</keeper.version>
        <kotlin.version>1.9.23</kotlin.version>
        <bouncycastle.version>1.0.2.4</bouncycastle.version>

        <!-- Plugin versions (centralized management) -->
        <minify-maven-plugin.version>2.0.1</minify-maven-plugin.version>
        <plexus-utils.version>3.5.1</plexus-utils.version>
        <frontend-maven-plugin.version>1.12.1</frontend-maven-plugin.version>
        <node.version>v18.18.0</node.version>
        <npm.version>9.8.1</npm.version>
    </properties>

    <modules>
        <!-- 核心协议层 -->
        <module>guacamole-common</module>
        <module>guacamole-common-js</module>

        <!-- 扩展接口层 -->
        <module>guacamole-ext</module>

        <!-- Web 应用核心 -->
        <module>guacamole</module>

        <!-- 认证扩展 Starters -->
        <module>extensions/guacamole-auth-jdbc</module>
        <module>extensions/guacamole-auth-header-starter</module>
        <module>extensions/guacamole-auth-duo-starter</module>
        <module>extensions/guacamole-auth-json-starter</module>
        <module>extensions/guacamole-auth-ldap-starter</module>
        <module>extensions/guacamole-auth-totp-starter</module>
        <module>extensions/guacamole-auth-radius-starter</module>
        <module>extensions/guacamole-auth-quickconnect-starter</module>
        <module>extensions/guacamole-auth-sso</module>
        <!-- Vault -->
        <module>extensions/guacamole-vault</module>
        <module>extensions/guacamole-history-starter</module>
    </modules>

    <dependencyManagement>
        <dependencies>

            <!-- 内部模块 -->
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-common-js</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-ext</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-jdbc-base</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-postgresql-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-sqlserver-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-header-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-mysql-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-quickconnect-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-totp-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-json-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-history-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-vault-base</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-vault-ksm-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-duo-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-ldap-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-radius-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-sso-base</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-sso-cas-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-sso-openid-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.right</groupId>
                <artifactId>guacamole-auth-sso-saml-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Guava -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <!-- Jackson -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- MyBatis Spring Boot Starter -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- ZXing (二维码) -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>javase</artifactId>
                <version>${zxing.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>

            <!-- Apache Directory LDAP API -->
            <dependency>
                <groupId>org.apache.directory.api</groupId>
                <artifactId>api-all</artifactId>
                <version>${apache-ldap.version}</version>
            </dependency>

            <!-- Apache Commons -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <!-- IPAddress -->
            <dependency>
                <groupId>com.github.seancfoley</groupId>
                <artifactId>ipaddress</artifactId>
                <version>${ipaddress.version}</version>
            </dependency>

            <!-- Jakarta REST API -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta-ws-rs.version}</version>
            </dependency>

            <!-- JRadius RADIUS library -->
            <dependency>
                <groupId>net.jradius</groupId>
                <artifactId>jradius-core</artifactId>
                <version>${jradius.version}</version>
            </dependency>
            <dependency>
                <groupId>net.jradius</groupId>
                <artifactId>jradius-dictionary</artifactId>
                <version>${jradius.version}</version>
            </dependency>
            <dependency>
                <groupId>net.jradius</groupId>
                <artifactId>jradius-extended</artifactId>
                <version>${jradius.version}</version>
            </dependency>

            <!-- Commons Logging -->
            <dependency>
                <groupId>commons-logging</groupId>
                <artifactId>commons-logging</artifactId>
                <version>${commons-logging.version}</version>
            </dependency>

            <!-- Commons Collections -->
            <dependency>
                <groupId>commons-collections</groupId>
                <artifactId>commons-collections</artifactId>
                <version>${commons-collections.version}</version>
            </dependency>

            <!-- CAS Client -->
            <dependency>
                <groupId>org.jasig.cas.client</groupId>
                <artifactId>cas-client-core</artifactId>
                <version>${cas-client.version}</version>
            </dependency>

            <!-- jose4j (JOSE implementation) -->
            <dependency>
                <groupId>org.bitbucket.b_c</groupId>
                <artifactId>jose4j</artifactId>
                <version>${jose4j.version}</version>
            </dependency>

            <!-- OneLogin SAML -->
            <dependency>
                <groupId>com.onelogin</groupId>
                <artifactId>java-saml</artifactId>
                <version>${java-saml.version}</version>
            </dependency>

            <!-- Woodstox -->
            <dependency>
                <groupId>com.fasterxml.woodstox</groupId>
                <artifactId>woodstox-core</artifactId>
                <version>${woodstox.version}</version>
            </dependency>

            <!-- Apache XML Security -->
            <dependency>
                <groupId>org.apache.santuario</groupId>
                <artifactId>xmlsec</artifactId>
                <version>${xmlsec.version}</version>
            </dependency>

            <!-- Keeper Security Secrets Manager -->
            <dependency>
                <groupId>com.keepersecurity.secrets-manager</groupId>
                <artifactId>core</artifactId>
                <version>${keeper.version}</version>
            </dependency>

            <!-- Kotlin -->
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-reflect</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib-jdk8</artifactId>
                <version>${kotlin.version}</version>
            </dependency>

            <!-- Bouncy Castle FIPS -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bc-fips</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- JavaScript / CSS minification for extension frontend
                     resources.  Same plugin and engine (Google Closure
                     Compiler) as the original Apache Guacamole project. -->
                <plugin>
                    <groupId>com.github.buckelieg</groupId>
                    <artifactId>minify-maven-plugin</artifactId>
                    <version>${minify-maven-plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.codehaus.plexus</groupId>
                            <artifactId>plexus-utils</artifactId>
                            <version>${plexus-utils.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>
                <!-- Restore Maven-native ${*} delimiter for all modules.
                     Spring Boot's parent POM replaces ${*} with @ to avoid
                     conflicts with application property placeholders, but
                     our build identifier uses ${guacamole.build.identifier}
                     just like the original Apache Guacamole project. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <configuration>
                        <useDefaultDelimiters>true</useDefaultDelimiters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- 统一 revision 版本 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
