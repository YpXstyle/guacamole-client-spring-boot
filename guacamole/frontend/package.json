{
    "name": "guacamole-frontend",
    "private": true,
    "description": "Apache Guacamole frontend (AngularJS 1.8) - build output to ../src/main/resources/static/",
    "scripts": {
        "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --progress",
        "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider webpack --progress --watch --mode development",
        "clean": "rm -rf ../src/main/resources/static/guacamole.*.js ../src/main/resources/static/guacamole.*.css ../src/main/resources/static/*.map ../src/main/resources/static/templates.js"
    },
    "dependencies": {
        "@simonwep/pickr": "^1.8.2",
        "angular": "^1.8.3",
        "angular-route": "^1.8.3",
        "angular-templatecache-webpack-plugin": "^1.0.1",
        "angular-translate": "^2.19.1",
        "angular-translate-interpolation-messageformat": "^2.19.1",
        "angular-translate-loader-static-files": "^2.19.1",
        "blob-polyfill": ">=7.0.20220408",
        "datalist-polyfill": "^1.25.1",
        "file-saver": "^2.0.5",
        "jquery": "^3.7.1",
        "jstz": "^2.1.1",
        "lodash": "^4.17.21"
    },
    "devDependencies": {
        "clean-webpack-plugin": "^4.0.0",
        "closure-webpack-plugin": "^2.6.1",
        "copy-webpack-plugin": "^5.1.2",
        "cross-env": "^10.1.0",
        "css-loader": "^5.2.7",
        "css-minimizer-webpack-plugin": "^1.3.0",
        "exports-loader": "^1.1.1",
        "find-package-json": "^1.2.0",
        "google-closure-compiler": "20221004.0.0",
        "html-webpack-plugin": "^4.5.2",
        "mini-css-extract-plugin": "^1.6.2",
        "terser-webpack-plugin": "^4.2.3",
        "webpack": "^4.47.0",
        "webpack-cli": "^4.10.0"
    }
}
