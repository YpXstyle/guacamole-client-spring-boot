<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                            http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.right</groupId>
        <artifactId>guacamole-client-spring-boot</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>guacamole</artifactId>
    <description>Apache Guacamole main web application module (Spring Boot)</description>

    <dependencies>

        <!-- Starter: JDBC Authentication -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-mysql-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-postgresql-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-sqlserver-starter</artifactId>
        </dependency>

        <!-- Starter: Quick Connect -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-quickconnect-starter</artifactId>
        </dependency>

        <!-- Starter: TOTP (Two-Factor Auth) -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-totp-starter</artifactId>
        </dependency>

        <!-- Starter: JSON Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-json-starter</artifactId>
        </dependency>

        <!-- Starter: HTTP Header Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-header-starter</artifactId>
        </dependency>

        <!-- Starter: DUO Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-duo-starter</artifactId>
        </dependency>

        <!-- Starter: LDAP Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-ldap-starter</artifactId>
        </dependency>

        <!-- Starter: RADIUS Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-radius-starter</artifactId>
        </dependency>

        <!-- Starter: SSO CAS -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-sso-cas-starter</artifactId>
        </dependency>

        <!-- Starter: SSO OpenID -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-sso-openid-starter</artifactId>
        </dependency>

        <!-- Starter: SSO SAML -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-sso-saml-starter</artifactId>
        </dependency>

        <!-- Vault Base -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-vault-base</artifactId>
        </dependency>

        <!-- Starter: Vault KSM -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-vault-ksm-starter</artifactId>
        </dependency>

        <!-- Starter: History Recording Storage -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-history-starter</artifactId>
        </dependency>

        <!-- Guacamole JavaScript API -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-common-js</artifactId>
        </dependency>

        <!-- Guacamole Extension API -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-ext</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jersey</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-jakarta-xmlbind-annotations</artifactId>
        </dependency>

        <!-- Guava -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- SLF4J Bridge -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
        </dependency>

        <!-- Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lombok (optional) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!-- Selective Maven resource filtering:
             - index.html + verifyCachedVersion.js: filtering=ON
               → ${guacamole.build.identifier} replaced with timestamp
             - application*.yml/properties: filtering=ON
               → Spring placeholder @...@ supported
             - everything else: filtering=OFF
               → JSON, JS, CSS, images passed through untouched -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>static/index.html</include>
                    <include>static/verifyCachedVersion.js</include>
                    <include>**/application*.yml</include>
                    <include>**/application*.yaml</include>
                    <include>**/application*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>static/index.html</exclude>
                    <exclude>static/verifyCachedVersion.js</exclude>
                    <exclude>**/application*.yml</exclude>
                    <exclude>**/application*.yaml</exclude>
                    <exclude>**/application*.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- ============================================================
                 Frontend Build Integration (frontend-maven-plugin)
                 Automates: install Node.js → npm ci → webpack build
                 Same approach as original Apache Guacamole project.
                 Output directory: src/main/resources/static/
                 ============================================================ -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.12.1</version>
                <configuration>
                    <workingDirectory>frontend</workingDirectory>
                    <installDirectory>${project.build.directory}/node</installDirectory>
                </configuration>
                <executions>
                    <!-- ① Install Node.js and npm -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>v18.18.0</nodeVersion>
                            <npmVersion>9.8.1</npmVersion>
                        </configuration>
                    </execution>
                    <!-- ② Install npm dependencies (ci for reproducible builds) -->
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <!-- ③ Run webpack build (generates static/ resources) -->
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy guacamole-common-js resources to static directory.
                 Runs at process-resources phase so files are available
                 regardless of build mode (IDE, mvn compile, mvn package).
                 Uses direct source copy instead of dependency unpack to
                 work correctly with Maven reactor builds. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-guacamole-common-js</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/classes/static/guacamole-common-js</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>../guacamole-common-js/src/main/resources</directory>
                                    <includes>
                                        <include>all.js</include>
                                        <include>all.min.js</include>
                                        <include>modules/**</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                    <!-- Copy core translation files from frontend source to
                         classpath:translations/. Mirrors original project where
                         webpack CopyPlugin copies translations to dist/ and
                         maven-war-plugin includes them. TranslationController
                         serves these at runtime via LanguageResourceService. -->
                    <execution>
                        <id>copy-core-translations</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/classes/translations</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>frontend/src/translations</directory>
                                    <includes>
                                        <include>*.json</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.apache.guacamole.GuacamoleSpringBootApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
