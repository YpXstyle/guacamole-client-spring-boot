        </dependency>
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-sqlserver-starter</artifactId>
        </dependency>

        <!-- Starter: Quick Connect -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-quickconnect-starter</artifactId>
        </dependency>

        <!-- Starter: TOTP (Two-Factor Auth) -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-totp-starter</artifactId>
        </dependency>

        <!-- Starter: JSON Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-json-starter</artifactId>
        </dependency>

        <!-- Starter: HTTP Header Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-header-starter</artifactId>
        </dependency>

        <!-- Starter: DUO Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-duo-starter</artifactId>
        </dependency>

        <!-- Starter: LDAP Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-ldap-starter</artifactId>
        </dependency>

        <!-- Starter: RADIUS Auth -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-radius-starter</artifactId>
        </dependency>

        <!-- Starter: SSO CAS -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-sso-cas-starter</artifactId>
        </dependency>

        <!-- Starter: SSO OpenID -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-sso-openid-starter</artifactId>
        </dependency>

        <!-- Starter: SSO SAML -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-auth-sso-saml-starter</artifactId>
        </dependency>

        <!-- Vault Base -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-vault-base</artifactId>
        </dependency>

        <!-- Starter: Vault KSM -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-vault-ksm-starter</artifactId>
        </dependency>

        <!-- Starter: History Recording Storage -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-history-starter</artifactId>
        </dependency>

        <!-- Guacamole JavaScript API -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-common-js</artifactId>
        </dependency>

        <!-- Guacamole Extension API -->
        <dependency>
            <groupId>com.right</groupId>
            <artifactId>guacamole-ext</artifactId>
        </dependency>

        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jersey</artifactId>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-multipart</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-jakarta-xmlbind-annotations</artifactId>
        </dependency>

        <!-- Guava -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!-- SLF4J Bridge -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>jul-to-slf4j</artifactId>
        </dependency>

        <!-- Configuration Processor -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
