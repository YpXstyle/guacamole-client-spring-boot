        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!-- Selective Maven resource filtering:
             - index.html + verifyCachedVersion.js: filtering=ON
               → ${guacamole.build.identifier} replaced with timestamp
             - application*.yml/properties: filtering=ON
               → Spring placeholder @...@ supported
             - everything else: filtering=OFF
               → JSON, JS, CSS, images passed through untouched -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>static/index.html</include>
                    <include>static/verifyCachedVersion.js</include>
                    <include>**/application*.yml</include>
                    <include>**/application*.yaml</include>
                    <include>**/application*.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>static/index.html</exclude>
                    <exclude>static/verifyCachedVersion.js</exclude>
                    <exclude>**/application*.yml</exclude>
                    <exclude>**/application*.yaml</exclude>
                    <exclude>**/application*.properties</exclude>
                </excludes>
            </resource>
            <!-- Core translation files: treat frontend/src/translations as a
                 standard Maven resource directory so they are available on the
                 classpath in both Maven and IDE builds.  No custom plugin
                 execution required. -->
            <resource>
                <directory>frontend/src/translations</directory>
                <filtering>false</filtering>
                <targetPath>translations</targetPath>
                <includes>
                    <include>*.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- ============================================================
                 Frontend Build (frontend-maven-plugin)
                 install Node → npm install → webpack → static/

                 npm install: auto-skipped when node_modules exists
                   (dependencies rarely change — no need to reinstall)
                 webpack: always runs (must compile latest frontend)

                 Manual overrides:
                   -Dforce.npm.install → force npm install even if
                    node_modules exists (after package.json changes)
                   -Dskip.frontend → skip entire frontend (webpack too)
                 ============================================================ -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>frontend</workingDirectory>
                    <installDirectory>${project.build.directory}/node</installDirectory>
                </configuration>
                <executions>
                    <!-- ① Install Node.js (cached in target/node/, fast) -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <!-- ② npm install — SKIPS when node_modules already exists
                         (profile skip-npm-install sets npm.install.skip=true) -->
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>install</arguments>
                            <skip>${npm.install.skip}</skip>
                        </configuration>
                    </execution>
                    <!-- ③ Webpack build → always runs (must compile latest) -->
                    <execution>
                        <id>npm-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.apache.guacamole.GuacamoleSpringBootApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ================================================================
         Profiles

         "native" / "nativeTest" are from Spring Boot parent POM
         (GraalVM native image). Don't affect normal builds.

         skip-npm-install: auto-skips "npm install" when node_modules
         already exists. This is the biggest time saver because npm
         install downloads packages every time but dependencies rarely
         change. webpack (npm build) still runs every time to compile
         the latest frontend.

         Override: mvn <goal> -Dforce.npm.install
         Skip all: mvn <goal> -Dskip.frontend
         ================================================================ -->
    <profiles>
        <!-- Auto-skip npm install when node_modules already exists.
             npm install is the slowest step (~30-60s) — it should only
             run when dependencies change (package.json updated).
             webpack build still runs every time (must compile latest). -->
        <profile>
            <id>skip-npm-install</id>
            <activation>
                <file>
                    <exists>frontend/node_modules</exists>
                </file>
                <property>
                    <name>!force.npm.install</name>
                </property>
            </activation>
            <properties>
                <npm.install.skip>true</npm.install.skip>
            </properties>
        </profile>
    </profiles>

</project>
