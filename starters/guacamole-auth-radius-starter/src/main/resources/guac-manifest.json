{

    "guacamoleVersion" : "1.5.5",

    "name"      : "RADIUS Authentication Backend",
    "namespace" : "radius",

    "configProperty" : "guacamole.auth.radius.enabled",

    "authProviders" : [
        "org.apache.guacamole.auth.radius.RadiusAuthenticationProvider"
    ],

    "js" : [
        "radiusModule.js",
        "config/radiusConfig.js",
        "controllers/radiusStateController.js"
    ],

    "html" : [
        "templates/radiusStateField.html"
    ],

    "translations" : [
        "translations/ca.json",
        "translations/de.json",
        "translations/en.json",
        "translations/ja.json",
        "translations/ru.json",
        "translations/zh.json"
    ],

    "resources" : {
        "templates/radiusStateField.html"    : "text/html"
    }

}
